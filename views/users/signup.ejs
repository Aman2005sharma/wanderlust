<% layout("/layouts/boiler") %>

<div class="auth-page signup-page">

    <div class="login-card">

        <div class="login-icon">
            <i class="fa-solid fa-compass"></i>
        </div>

        <h2>Create Your Account</h2>

        <p class="subtitle">
            Join Wanderlust and start exploring.
        </p>

        <form action="/signup" method="POST">

            <!-- Username -->
            <div class="mb-3">
                <label>Username</label>

                <div class="input-box">
                    <i class="fa-solid fa-user"></i>

                    <input
                        type="text"
                        name="username"
                        class="form-control"
                        placeholder="Enter username"
                        required>
                </div>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label>Email</label>

                <div class="input-box">
                    <i class="fa-solid fa-envelope"></i>

                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter email"
                        required>
                </div>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label>Password</label>

                <div class="input-box">
                    <i class="fa-solid fa-lock"></i>

                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        placeholder="Create password"
                        required>
                </div>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
                <label>Confirm Password</label>

                <div class="input-box">
                    <i class="fa-solid fa-lock"></i>

                    <input
                        type="password"
                        name="confirmPassword"
                        class="form-control"
                        placeholder="Confirm password"
                        required>
                </div>
            </div>

            <button class="login-btn">
                Create Account
            </button>

        </form>

        <p class="signup-link mt-4">
            Already have an account?
            <a href="/login">Login</a>
        </p>

    </div>

</div>