<% layout("/layouts/boiler") %>

<div class="auth-page">

    <!-- LEFT SIDE -->
    <div class="auth-image signup-image">
        <div class="auth-image-overlay">
                <span class="auth-badge">
        ✦ Travel beyond ordinary
    </span>
            <h1>Join Wanderlust</h1>
            <p>
                Create your account and discover amazing places
                around the world.
            </p>

            <div class="travel-stats">
    <div>
        <strong>10K+</strong>
        <span>Travelers</span>
    </div>

    <div>
        <strong>500+</strong>
        <span>Destinations</span>
    </div>

    <div>
        <strong>4.9</strong>
        <span>Rating ★</span>
    </div>
</div>
        </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="auth-form">

        <div class="login-card signup-card">

            <div class="login-icon">
                <i class="fa-solid fa-compass"></i>
            </div>

            <h2>Create Your Account</h2>

            <p class="subtitle">
                Join Wanderlust and start exploring.
            </p>

            <form action="/signup" method="POST">

                <div class="auth-input">
                    <label>Username</label>

                    <div class="input-box">
                        <i class="fa-solid fa-user"></i>

                        <input
                            type="text"
                            name="username"
                            placeholder="Enter username"
                            required>
                    </div>
                </div>

                <div class="auth-input">
                    <label>Email</label>

                    <div class="input-box">
                        <i class="fa-solid fa-envelope"></i>

                        <input
                            type="email"
                            name="email"
                            placeholder="Enter email"
                            required>
                    </div>
                </div>

                <div class="auth-input">
                    <label>Password</label>

                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>

                        <input
                            type="password"
                            name="password"
                            placeholder="Create password"
                            required>
                    </div>
                </div>

                <div class="auth-input">
                    <label>Confirm Password</label>

                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>

                        <input
                            type="password"
                            name="confirmPassword"
                            placeholder="Confirm password"
                            required>
                    </div>
                </div>

                <button class="login-btn">
                    Create Account
                </button>

            </form>

            <p class="signup-link">
                Already have an account?
                <a href="/login">Login</a>
            </p>

        </div>

    </div>

</div>