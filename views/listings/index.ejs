<% layout("/layouts/boiler") %> 

<section class="hero-banner">
  <div class="hero-overlay">
            <div class="hero-badge">
            ✦ Explore stays worth remembering
        </div>
     <h1>
    Har Safar,<br>
    <span>Ek Nayi Kahani</span>
</h1>
    <p>Discover unique places around the world</p>
  </div>
</section>

<div class="filters-container">
  <div id="filters">

 <a href="/listings"
   class="filter <%= selectedCategory === 'all' ? 'active' : '' %>">
    <div><i class="fa-solid fa-globe"></i></div>
    <span>All</span>

</a>

      <a href="/listings?category=trending" 
      class="filter <%= selectedCategory === 'trending' ? 'active' : '' %>" >
  <div><i class="fa-solid fa-fire"></i></div>
    <span>Trending</span>

</a>
   
       <a href="/listings?category=bedroom" 
       class="filter
       <%= selectedCategory === 'bedroom' ? 'active' : '' %>">
  <div><i class="fa-solid fa-bed"></i></div>
  <span>Bedrooms</span>
</a>
  
       <a href="/listings?category=iconic cities" 
       class="filter <%= selectedCategory === 'iconic cities' ? 'active' : '' %>">
  <div><i class="fa-solid fa-mountain-city"></i></div>
    <span>Iconic Cities</span>

</a>
    
      <a href="/listings?category=mountains" 
      class="filter <%= selectedCategory === 'mountains' ? 'active' : '' %>">
  <div><i class="fa-solid fa-mountain"></i></div>
  <span>Mountains</span>

</a>
   
       <a href="/listings?category=amazing-pools"
        class="filter <%= selectedCategory === 'amazing-pools' ? 'active' : '' %>">
  <div><i class="fa-solid fa-person-swimming"></i></div>
  <span>Amazing Pools</span>

</a>
    
       <a href="/listings?category=beaches"
        class="filter <%= selectedCategory === 'beaches' ? 'active' : '' %>" >
  <div><i class="fa-solid fa-umbrella-beach"></i></div>
  <span>Beach</span>

</a>
   
    
       <a href="/listings?category=tents" 
       class="filter <%= selectedCategory === 'tents' ? 'active' : '' %>">
  <div><i class="fa-solid fa-campground"></i></div>
  <span>Tent</span>

</a>
    
       <a href="/listings?category=snow"
        class="filter <%= selectedCategory === 'snow' ? 'active' : '' %>">
  <div><i class="fa-regular fa-snowflake"></i></div>
  <span>Arctic</span>

</a>
    

    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display total after  Taxes</label>
</div>
    </div>
    
  </div>
  </div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 listings-grid">
  <% for(let listing of allListings) { %>

    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card listing-card">

        <img 
          src="<%= listing.image?.url || 'https://via.placeholder.com/300' %>" 
          class="card-img-top"
          style="height: 20rem; object-fit: cover;"
          alt="listing image"
        />

        <% if(currUser) { %>
  <form method="POST" action="/wishlist/<%= listing._id %>" class="wishlist-form">
    <button class="wishlist-btn">
     <i class="fa-regular fa-heart"></i>
    </button>
  </form>
 <% } %>

        <div class="card-body">
          <b class="listing-title"><%= listing.title %></b><br>
          &#8377; <%= listing.price != null 
                ? listing.price.toLocaleString("en-IN") 
                : "0" %> /night
                <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
        </div>

      </div>
    </a>

  <% } %>
</div>

<script>
  let taxSwitch=document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
    let taxInfo=document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display !="inline") {
        info.style.display ="inline";
      }else{
        info.style.display="none";
      }
    }
  });
</script>

<% if (allListings.length > 0) { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1">
    <% for (let listing of allListings) { %>
    <% } %>
  </div>
<% } else { %>
  <div class="text-center py-5">
    <h3>No places found</h3>
    <p>Try a different search or category.</p>
    <a href="/listings" class="btn btn-dark">Show all listings</a>
  </div>
<% } %>